# Copy to .env and adjust. Never commit a real .env. No secrets are required for local use.
# The API reads ARCHSIM_* variables (and a .env file in its working directory).

# --- API (services/api) -------------------------------------------------------------------
# Database. Default: a SQLite file in the working directory (zero setup).
ARCHSIM_DATABASE_URL=sqlite:///./archsim.db
# PostgreSQL (start it with: docker compose up -d postgres)
# ARCHSIM_DATABASE_URL=postgresql+psycopg://archsim:archsim@127.0.0.1:5432/archsim

# Directory with example documents (auto-detected from the repository when unset)
# ARCHSIM_EXAMPLES_DIR=./examples

# Browser origins allowed to call the API directly (JSON list). The web app normally uses its
# own same-origin proxy, so this rarely needs changing.
ARCHSIM_CORS_ORIGINS=["http://localhost:3000"]

# Apply Alembic migrations on startup
ARCHSIM_AUTO_MIGRATE=true

# Runs wait in a queue in the database. The API simulates them itself unless
# ARCHSIM_EMBEDDED_WORKER=false (then run `archsim-api worker` processes). Each run simulates in
# a process of its own (one core each); ARCHSIM_RUNNER=thread simulates in the worker's threads.
ARCHSIM_EMBEDDED_WORKER=true
ARCHSIM_RUNNER=process
# Runs per worker at once. Default: CPU count - 1.
# ARCHSIM_MAX_CONCURRENT_RUNS=3
# A run whose worker stops renewing it for this long is requeued (failed after two attempts).
# ARCHSIM_LEASE_SECONDS=30
# How long a cancelled run may take to stop before its process is killed.
# ARCHSIM_CANCEL_GRACE_SECONDS=10
# Simulation limits.
ARCHSIM_MAX_WALL_SECONDS=300
ARCHSIM_MAX_REQUESTS=2000000
ARCHSIM_MAX_BODY_BYTES=5000000
ARCHSIM_RUN_HISTORY_LIMIT=200

# Load third-party component models from installed packages (entry point group
# "archsim.components"). Only enable for packages you trust.
# ARCHSIM_ENABLE_PLUGINS=1

# --- Sign-in and hosting (SECURITY.md) --------------------------------------------------------
# none: no sign-in, every request is the local owner of the "default" workspace (local use only).
# oauth: GitHub/Google sign-in, workspaces with roles, API tokens, CSRF checks, rate limits.
ARCHSIM_AUTH_MODE=none
# Required with oauth. Signs the sign-in state and derives CSRF tokens: 32+ random characters,
# the same on every API instance (python -c "import secrets; print(secrets.token_urlsafe(48))").
# ARCHSIM_SECRET_KEY=
# Required with oauth: the address people open. OAuth apps' callback URLs are
# <public url>/api/v1/auth/github/callback and <public url>/api/v1/auth/google/callback.
# ARCHSIM_PUBLIC_URL=https://archsim.example.com
# At least one provider with oauth.
# ARCHSIM_GITHUB_CLIENT_ID=
# ARCHSIM_GITHUB_CLIENT_SECRET=
# GitHub Enterprise Server: its address and API (<address>/api/v3).
# ARCHSIM_GITHUB_URL=https://github.com
# ARCHSIM_GITHUB_API_URL=https://api.github.com
# ARCHSIM_GOOGLE_CLIENT_ID=
# ARCHSIM_GOOGLE_CLIENT_SECRET=
# Verified emails (comma separated) whose first sign-in makes them an owner of the default
# workspace.
# ARCHSIM_ADMIN_EMAILS=you@example.com
# How long a sign-in lasts, in days.
# ARCHSIM_SESSION_DAYS=30
# Addresses whose X-ArchSim-Client-IP header the API believes: the web server's (IPs, CIDRs or
# host names such as the Compose service "web"). Everyone else is rate-limited by their own
# address.
# ARCHSIM_TRUSTED_PROXIES=127.0.0.1,::1
# Calls to Prometheus servers a request names: open | allowlist | off. Default: open without
# sign-in; with it, allowlist when ARCHSIM_PROMETHEUS_ALLOWED_HOSTS is set, else off. Sandbox
# workspaces never call out.
# ARCHSIM_OUTBOUND=
# Prometheus hosts calibration may query (host or host:port, comma separated). Hosted, a listed
# name must resolve to public addresses; an IP address listed here is trusted as written.
# ARCHSIM_PROMETHEUS_ALLOWED_HOSTS=
# Rate limits and per-kind workspace limits (429 with Retry-After). Default: on with oauth.
# ARCHSIM_RATE_LIMITS=

# --- Tests ----------------------------------------------------------------------------------
# Run API tests against PostgreSQL. WARNING: every table in this database is dropped per test.
# ARCHSIM_TEST_DATABASE_URL=postgresql+psycopg://archsim:archsim@127.0.0.1:5432/archsim_test

# --- Web (apps/web) -------------------------------------------------------------------------
# Where the Next.js server forwards /api/v1/* requests (read at runtime).
ARCHSIM_API_URL=http://127.0.0.1:8000
# How many proxies of yours stand in front of the web server (1 behind Caddy or nginx). The
# visitor's address is read from X-Forwarded-For at that depth and sent to the API; 0 sends none.
# ARCHSIM_TRUSTED_HOPS=0
# Opt out of Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
