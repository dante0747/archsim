# Copy to .env and adjust. Never commit a real .env. No secrets are required for local use.
# The API reads ARCHSIM_* variables (and a .env file in its working directory).

# --- API (services/api) -------------------------------------------------------------------
# Database. Default: a SQLite file in the working directory (zero setup).
ARCHSIM_DATABASE_URL=sqlite:///./archsim.db
# PostgreSQL (start it with: docker compose up -d postgres)
# ARCHSIM_DATABASE_URL=postgresql+psycopg://archsim:archsim@127.0.0.1:5432/archsim

# Directory with example documents (auto-detected from the repository when unset)
# ARCHSIM_EXAMPLES_DIR=./examples

# Browser origins allowed to call the API directly (JSON list). The web app normally uses its
# own same-origin proxy, so this rarely needs changing.
ARCHSIM_CORS_ORIGINS=["http://localhost:3000"]

# Apply Alembic migrations on startup
ARCHSIM_AUTO_MIGRATE=true

# Simulation limits
ARCHSIM_MAX_CONCURRENT_RUNS=2
ARCHSIM_MAX_WALL_SECONDS=300
ARCHSIM_MAX_REQUESTS=2000000
ARCHSIM_MAX_BODY_BYTES=5000000
ARCHSIM_RUN_HISTORY_LIMIT=200

# Load third-party component models from installed packages (entry point group
# "archsim.components"). Only enable for packages you trust.
# ARCHSIM_ENABLE_PLUGINS=1

# --- Tests ----------------------------------------------------------------------------------
# Run API tests against PostgreSQL. WARNING: every table in this database is dropped per test.
# ARCHSIM_TEST_DATABASE_URL=postgresql+psycopg://archsim:archsim@127.0.0.1:5432/archsim_test

# --- Web (apps/web) -------------------------------------------------------------------------
# Where the Next.js server forwards /api/v1/* requests (read at runtime).
ARCHSIM_API_URL=http://127.0.0.1:8000
# Opt out of Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
