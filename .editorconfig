# Editor settings that match the Java formatter (docs/java-conventions.md). Python and the web app
# keep their own formatters' settings (ruff, the web app's ESLint).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# Spring's style: tabs, 120 columns. `./gradlew format` applies it.
[*.java]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 120
trim_trailing_whitespace = true

[config/checkstyle/*.xml]
indent_style = tab
indent_size = 4

[*.bat]
end_of_line = crlf
