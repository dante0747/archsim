  "scenarios": [
    {
      "id": "baseline",
      "name": "Baseline (a post goes viral at 20\u201350 s)",
      "description": "The document as drawn. When the post goes viral, the Photos API scales out to 155 instances (120 cold starts, 0.3% of its requests) and uploads stay under 400 ms at p95. The worker reaches its 300 instances and the queue takes the rest: the backlog peaks at about 5,600 jobs as the spike ends and is gone 30 s later. A thumbnail is ready about 21 s after its upload at p95. Nothing fails apart from one S3 error.",
      "overrides": []
    },
    {
      "id": "low-concurrency",
      "name": "Reserved concurrency 100",
      "description": "The worker capped at 100 instances, with the event source's maximum concurrency lowered to match. 100 instances do about 87 jobs a second: enough for the 75 uploads a second of a normal evening, not for the spike. The backlog peaks at about 10,900 and drains at about 12 a second, so thumbnails are 91 s late at p95 and about 4,800 jobs are still waiting a minute after uploads stop. Uploads themselves are unaffected: the queue keeps the worker's limit away from users. Size reserved concurrency for the drain time you can accept, not for the average.",
      "overrides": [
        {
          "target": {
            "kind": "node",
            "id": "resizer"
          },
          "path": "concurrencyLimit",
          "value": 100
        },
        {
          "target": {
            "kind": "node",
            "id": "jobs"
          },
          "path": "consumers",
          "value": 100
        }
      ]
    },
    {
      "id": "small-worker",
      "name": "Resize worker at 512 MB",
      "description": "The worker given 512 MB instead of 1,792 MB to save money. Lambda allocates CPU in proportion to memory, so it gets about 0.29 vCPU and a job takes 3.6 s instead of 1.15 s. The same 300 instances now manage about 83 jobs a second, so the result looks like 100 instances at full size: the backlog peaks at about 11,000, thumbnails are 93 s late at p95, and about 5,500 jobs are left at the end. Per image it is only about 10% cheaper (1.8 GB-seconds instead of 2.0): for CPU-bound work, less memory mostly buys time.",
      "overrides": [
        {
          "target": {
            "kind": "node",
            "id": "resizer"
          },
          "path": "memoryGib",
          "value": 0.5
        },
        {
          "target": {
            "kind": "node",
            "id": "resizer"
          },
          "path": "cpuCores",
          "value": 0.29
        }
      ]
    },
    {
      "id": "java-worker",
      "name": "Resize worker on Java",
      "description": "The same worker on Java, with the same resize time once warm. The cold starts (about 1.2 s each instead of about 0.25 s) are the small part: a new Java instance also runs about 2.5 times slower until its JIT compiler has warmed up (45 s, illustrative), and during the spike every one of the 300 instances is new. The backlog peaks at about 7,700 instead of 5,600 and drains 12 s later; thumbnails are 29.5 s late at p95 instead of 21.5 s. SnapStart and provisioned concurrency, which address this, are not modelled.",
      "overrides": [
        {
          "target": {
            "kind": "node",
            "id": "resizer"
          },
          "path": "technology",
          "value": "java"
        }
      ]
    },
    {
      "id": "s3-slow",
      "name": "S3 8\u00d7 slower for 30 s (80\u2013110 s)",
      "description": "Chaos: from 80 to 110 s the originals bucket answers 8 times slower (a median of about half a second). Users feel it, because an upload waits for its PUT: p95 inside the window rises from 336 ms to about 1.3 s, and a few uploads hit the 2.5 s PUT timeout (99.8% of requests in the window succeed). The worker hardly notices: its GETs take longer, but it has room under its 300 instances, and the backlog is the spike's alone.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "faults",
          "value": [
            {
              "id": "s3-slow",
              "kind": "slowdown",
              "target": "originals",
              "startS": 80,
              "durationS": 30,
              "factor": 8,
              "label": "originals bucket 8\u00d7 slower"
            }
          ]
        }
      ]
    }
  ],
