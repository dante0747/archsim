  "scenarios": [
    {
      "id": "baseline",
      "name": "Baseline",
      "description": "The document as drawn, measured after a 30 s warm-up. The POPs serve about 89% of requests from cache and the shield about 31% of what they miss, so about 8% of requests (about 120 a second) reach the packager and S3. Most of those are segments requested for the first time in the run, the long tail, which is why the origin's rate falls from about 140 to about 100 a second as the run goes on. p95 is about 230 ms, most of it the viewers' own network.",
      "overrides": []
    },
    {
      "id": "premiere",
      "name": "Premiere: 2.5\u00d7 viewers on the new episode",
      "description": "The evening of a premiere: viewers concentrate on the new episode (Zipf 1.35 instead of 1.2), and when it starts at 50 s they jump from 1,500 to 3,750 segment requests a second for 20 s. The POPs serve about 95% of requests. During the premiere the origin gets about 135 requests a second, under 4% of what viewers ask for, against about 70 just before it and about 120 in the baseline at the same time. The CDN takes the spike; the packager stays below half of what it can do.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "pattern",
          "value": {
            "kind": "burst",
            "burstRps": 3750,
            "startS": 50,
            "durationS": 20
          }
        },
        {
          "target": {
            "kind": "workload"
          },
          "path": "keySkew",
          "value": 1.35
        }
      ]
    },
    {
      "id": "short-ttl",
      "name": "Every object cached for 2 s (live-style)",
      "description": "The POPs and the shield keep every object for 2 s, as they would a live stream's manifests. Each POP now fetches every popular segment again every 2 s, so the POPs serve only about 45% of requests, and the packager, sized for video on demand, is asked for more than it can do: about 1,700 requests a second with retries, against the about 320 it can package. It saturates, the POPs and the players retry (1.35 attempts per request), about 5% of requests fail and p95 reaches about 3.6 s. Short-lived objects need an origin sized for them, not for the hit ratio of long-lived ones.",
      "overrides": [
        {
          "target": {
            "kind": "node",
            "id": "pop-us"
          },
          "path": "ttlSeconds",
          "value": 2
        },
        {
          "target": {
            "kind": "node",
            "id": "pop-eu"
          },
          "path": "ttlSeconds",
          "value": 2
        },
        {
          "target": {
            "kind": "node",
            "id": "pop-ap"
          },
          "path": "ttlSeconds",
          "value": 2
        },
        {
          "target": {
            "kind": "node",
            "id": "shield"
          },
          "path": "ttlSeconds",
          "value": 2
        }
      ]
    },
    {
      "id": "shield-down",
      "name": "Origin shield down for 20 s (50\u201370 s)",
      "description": "Chaos: the shield, a single Varnish node, refuses connections for 20 s. Every POP miss then fails, after one retry at the POP and the players' own retries, so only what the POPs already hold keeps playing: inside the window about 92% of requests succeed, close to the POPs' 89% hit ratio (a player's retry can land on another POP that has the segment). p95 inside the window is lower than before it, because the slow requests, the misses, are the ones failing. A second shield node, or an origin group that falls back to the packager, would cover the gap.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "faults",
          "value": [
            {
              "id": "shield-down",
              "kind": "outage",
              "target": "shield",
              "startS": 50,
              "durationS": 20
            }
          ]
        }
      ]
    },
    {
      "id": "cold-start",
      "name": "Cold start: the first 20 s with empty caches",
      "description": "The first 20 s after every cache was emptied (a purge, or a new CDN configuration), measured from the first request. For the first 10 s the packager runs at its CPU limit (about 320 segments a second), its queue reaches about 200 requests and p95 averages about 1.1 s; once the popular segments are cached, p95 is back to about 250 ms. Nothing fails, because the players' timeouts are long, but viewers who start in those seconds wait about a second for a segment. Warming the cache with the most popular segments before a launch avoids it.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "durationS",
          "value": 20
        },
        {
          "target": {
            "kind": "workload"
          },
          "path": "warmupS",
          "value": 0
        }
      ]
    }
  ],
