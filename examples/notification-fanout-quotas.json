  "scenarios": [
    {
      "id": "baseline",
      "name": "Baseline (campaign at 20\u201328 s)",
      "description": "The document as drawn. Callers get their answer within about 90 ms at p95, whatever the providers do. The campaign becomes backlog: pushes go out within about a second (p95 message age), texts within about 25 s, and e-mail, sent at the quota's 50 a second by its 10 workers (one call in the whole run comes back 429 and is retried), needs until about 100 s: its backlog peaks near 2,800 messages and the p95 e-mail waits about 53 s. Slow, but nothing is lost. SMS is a quarter of the messages and about two thirds of the provider bill.",
      "overrides": []
    },
    {
      "id": "more-email-senders",
      "name": "Scale the email sender to 40 workers",
      "description": "The usual reflex when a backlog grows: 40 e-mail workers (8 pods) instead of 10. The provider still accepts 50 calls a second, so the extra calls come back as 429s: it refuses about 64% of the calls it gets, the senders' three attempts and SQS's redeliveries (about 1,800 failed deliveries) keep them coming, and 9 e-mails are dead-lettered after five deliveries. The campaign's e-mail is done no sooner (at about 100 s, as drawn), and the typical one goes out later (p95 age about 63 s against 53 s), because a message that fails three attempts goes to the back of the queue. The headline says no component is saturated; the critical throttling finding sits below it. The quota sets the pace: only a bigger one would send the campaign faster.",
      "overrides": [
        {
          "target": {
            "kind": "node",
            "id": "email-q"
          },
          "path": "consumers",
          "value": 40
        },
        {
          "target": {
            "kind": "node",
            "id": "email-sender"
          },
          "path": "replicas",
          "value": 8
        }
      ]
    },
    {
      "id": "sms-down",
      "name": "SMS provider down for 30 s (60\u201390 s)",
      "description": "Chaos: the SMS provider refuses every call. Each text fails its three attempts within a second, goes back to the queue, and after five deliveries lands in the dead-letter queue: about 75 texts, most of those sent during the outage, stay unsent until someone redrives them. Push and e-mail carry on untouched, because each channel has its own queue and senders, and callers notice nothing (the fault finding says the system absorbed it).",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "faults",
          "value": [
            {
              "id": "sms-down",
              "kind": "outage",
              "target": "sms",
              "startS": 60,
              "durationS": 30
            }
          ]
        }
      ]
    },
    {
      "id": "sms-down-backoff",
      "name": "SMS provider down, sender backs off",
      "description": "The same outage, with the SMS sender retrying each call up to 5 times with exponential backoff (0.8, 1.6, 3.2 and 6.4 s). With 3 s timeouts one delivery takes at most 27 s, inside SQS's 30 s visibility timeout, so no other worker picks the message up meanwhile. The workers wait instead of failing: the SMS backlog grows to about 75 texts and those sent during the outage go out up to about 23 s late, but none is dead-lettered.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "faults",
          "value": [
            {
              "id": "sms-down",
              "kind": "outage",
              "target": "sms",
              "startS": 60,
              "durationS": 30
            }
          ]
        },
        {
          "target": {
            "kind": "edge",
            "id": "sms-sender-sms"
          },
          "path": "maxAttempts",
          "value": 5
        },
        {
          "target": {
            "kind": "edge",
            "id": "sms-sender-sms"
          },
          "path": "retryBackoffMs",
          "value": 800
        }
      ]
    },
    {
      "id": "sms-everyone",
      "name": "Every notification also sent as SMS",
      "description": "Product asks for a text with every notification: four times the SMS. The 12 SMS workers send about 26 a second, under the 30/s quota, so the campaign's texts take minutes: hundreds are still queued when the run ends and the p95 text waits nearly two minutes. More workers would only reach the quota's 30 a second. The monthly cost doubles, nearly all of the increase SMS.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "readRatio",
          "value": 0.0
        }
      ]
    }
  ],
