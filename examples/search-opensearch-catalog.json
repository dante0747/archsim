          "shards": 3,
          "readReplicas": 1,
          "maxConnections": 21,
          "queueCapacity": 200,
          "queueTimeoutMs": null,
          "readServiceTimeMs": {
            "kind": "lognormal",
            "median": 13,
            "p95": 50
          },
          "writeServiceTimeMs": {
            "kind": "lognormal",
            "median": 6,
            "p95": 25
          },
          "cpuCores": 8,
          "cpuShare": 0.7,
          "routerOverheadMs": 2,
          "replicaApplyFactor": 1.0,
