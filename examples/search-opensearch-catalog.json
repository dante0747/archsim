  "scenarios": [
    {
      "id": "baseline",
      "name": "Baseline",
      "description": "The document as drawn. About 40% of searches are answered by the query cache; the rest reach OpenSearch, whose CPU is about 65% busy. A search takes about 33 ms there on average (p95 about 75 ms), and p95 end to end is about 185 ms, most of it the shoppers' own network. A seller's edit is in the index about 70 ms (p95) after Kafka has it.",
      "overrides": []
    },
    {
      "id": "overshard",
      "name": "Oversharded: 12 small shards on the same hardware",
      "description": "The same six nodes with the index cut into 12 primary shards of about 7.5 GiB instead of 3 of 30 GiB. The engine runs each shard copy as an instance of its own, so each gets a quarter of a node (2 vCPU, 16 GiB, 6 threads) and the hardware stays the same. A shard query searches a quarter of the documents but is not four times cheaper (median 4.5 ms instead of 13 ms), and every search now runs 12 of them: at the same load OpenSearch's CPU goes from about 65% to about 91% and its search time from about 33 to about 61 ms. Shoppers hardly notice yet (p95 about 210 ms), but the headroom is gone: on Breaking point the drawn design serves every request at 2,000 req/s, the oversharded one fails one in five at 1,500.",
      "overrides": [
        {
          "target": {
            "kind": "node",
            "id": "search"
          },
          "path": "shards",
          "value": 12
        },
        {
          "target": {
            "kind": "node",
            "id": "search"
          },
          "path": "cpuCores",
          "value": 2
        },
        {
          "target": {
            "kind": "node",
            "id": "search"
          },
          "path": "memoryGib",
          "value": 16
        },
        {
          "target": {
            "kind": "node",
            "id": "search"
          },
          "path": "maxConnections",
          "value": 6
        },
        {
          "target": {
            "kind": "node",
            "id": "search"
          },
          "path": "readServiceTimeMs",
          "value": {
            "kind": "lognormal",
            "median": 4.5,
            "p95": 18
          }
        },
        {
          "target": {
            "kind": "node",
            "id": "search"
          },
          "path": "queueCapacity",
          "value": 50
        },
        {
          "target": {
            "kind": "node",
            "id": "search"
          },
          "path": "routerOverheadMs",
          "value": 4
        }
      ]
    },
    {
      "id": "peak",
      "name": "Evening peak: 2,400 req/s for 25 s (45\u201370 s)",
      "description": "Traffic rises from 1,400 to 2,400 req/s for 25 s. The searches that miss the cache need more CPU than six nodes have, the search queues fill and OpenSearch turns away about a fifth of what it gets (HTTP 429, shown as 'queue full'). During the peak about 86% of requests succeed (91% over the measured 50 s, p95 about 560 ms); over the run the web shop, which does not retry, keeps about 88% and the mobile app, which retries once, about 97%. Listing updates fall behind as well, because index writes share the cluster: Kafka's lag reaches about 2,300 messages and an edit takes up to about 18 s (p95) to reach the index.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "pattern",
          "value": {
            "kind": "burst",
            "burstRps": 2400,
            "startS": 45,
            "durationS": 25
          }
        }
      ]
    },
    {
      "id": "peak-replica",
      "name": "Evening peak with a second replica",
      "description": "The same peak with two replicas of every shard: nine nodes instead of six. Each search can use any of three copies of a shard, OpenSearch's CPU stays at about 60%, every request succeeds and p95 stays at about 190 ms. The price is half as many search nodes again, and every index write now waits until two replicas have indexed the document instead of one. Replicas add read throughput; shards do not.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "pattern",
          "value": {
            "kind": "burst",
            "burstRps": 2400,
            "startS": 45,
            "durationS": 25
          }
        },
        {
          "target": {
            "kind": "node",
            "id": "search"
          },
          "path": "readReplicas",
          "value": 2
        }
      ]
    },
    {
      "id": "slowdown",
      "name": "OpenSearch 3\u00d7 slower for 20 s (45\u201365 s)",
      "description": "Chaos: every OpenSearch node runs 3\u00d7 slower for 20 s (heavy segment merging after a bulk load, or long garbage-collection pauses). The search API gives a search 1 s and does not retry it, and the search queues are short (200 per node, not OpenSearch's default 1,000), so the cluster turns work away instead of piling up searches the API has already given up on. Inside the window about 56% of requests succeed: the 40% the query cache answers, and some of the rest. The cluster is back to normal about 2 s after the slowdown ends.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "faults",
          "value": [
            {
              "id": "merge-storm",
              "kind": "slowdown",
              "target": "search",
              "startS": 45,
              "durationS": 20,
              "factor": 3
            }
          ]
        }
      ]
    }
  ],
