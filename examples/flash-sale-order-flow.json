  "scenarios": [
    {
      "id": "baseline",
      "name": "Baseline (the sale opens at 20 s)",
      "description": "The document as drawn: orders spread over 5,000 SKUs (Zipf 0.8). Shoppers stay under 40 ms at p95. Payments fall behind while the sale peaks (the SQS backlog reaches about 3,000 messages, p95 wait about 14 s) and catch up about half a minute after it.",
      "overrides": []
    },
    {
      "id": "deal",
      "name": "Deal of the day: 44% of orders for one SKU",
      "description": "SKU popularity follows Zipf 1.6, so the deal SKU gets about 44% of all orders, and every one of them updates the same stock row. PostgreSQL makes the second writer wait until the first commits, holding its connection meanwhile. At the sale's peak about 160 orders a second queue for one row that takes 7 to 8 ms per update: writes wait about 100 ms on average for the lock, checkout threads pile up and its queue overflows, while the database's connections are about 10% busy. About 7% of requests fail and p95 misses the objective.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "keySkew",
          "value": 1.6
        }
      ]
    },
    {
      "id": "deal-short-tx",
      "name": "Deal of the day, shorter stock transaction",
      "description": "The same deal with the locked part of the write cut from about 6 ms to about 2 ms (for example one UPDATE ... RETURNING that decrements the stock, instead of reading, updating and inserting the order in one transaction). The hot row keeps up: lock waits fall below 1 ms and every request succeeds. With a hot row, how long the lock is held matters more than how big the database is.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "keySkew",
          "value": 1.6
        },
        {
          "target": {
            "kind": "node",
            "id": "shop-db"
          },
          "path": "writeServiceTimeMs",
          "value": {
            "kind": "lognormal",
            "median": 1.5,
            "p95": 5
          }
        }
      ]
    },
    {
      "id": "carrier-hangs",
      "name": "Carrier API hangs for 40 s (50\u201390 s)",
      "description": "Chaos: the network path to the carrier adds 3 s each way, so every label call times out (two attempts of 5 s). Fulfilment drains a few messages a second, RabbitMQ's backlog reaches its memory watermark (40% of 0.25 GiB at 64 KB a message, about 1,640 messages) and the broker blocks publishers. The payment workers then wait inside a publish for longer than SQS's 30 s visibility timeout, so SQS hands their messages to other consumers: about 80 payments are processed twice, one per blocked consumer. Only the idempotency key on the charge stops those becoming double charges. Shoppers notice nothing.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "faults",
          "value": [
            {
              "id": "carrier-hangs",
              "kind": "latency",
              "target": "fulfilment-carrier",
              "startS": 50,
              "durationS": 40,
              "extraMs": 3000,
              "label": "carrier network path hangs"
            }
          ]
        }
      ]
    },
    {
      "id": "carrier-hangs-visibility",
      "name": "Carrier hangs, 5-minute visibility timeout",
      "description": "The same fault with the payment queue's visibility timeout at 300 s. Back-pressure still stops the payment workers and the SQS backlog grows (to about 4,200 messages), but no message is handed out twice: payments are late, not duplicated.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "faults",
          "value": [
            {
              "id": "carrier-hangs",
              "kind": "latency",
              "target": "fulfilment-carrier",
              "startS": 50,
              "durationS": 40,
              "extraMs": 3000,
              "label": "carrier network path hangs"
            }
          ]
        },
        {
          "target": {
            "kind": "node",
            "id": "payments-q"
          },
          "path": "visibilityTimeoutS",
          "value": 300
        }
      ]
    },
    {
      "id": "carrier-hangs-buffer",
      "name": "Carrier hangs, RabbitMQ with 4 GiB",
      "description": "The other fix: give the broker 16 times the memory, so its watermark (about 26,000 messages) is never reached in a 40 s hang. Nothing pushes back: payments carry on as normal and the fulfilment backlog absorbs the hang instead (peak about 5,900 messages, p95 wait about 42 s). A longer outage would still reach the watermark, later and with a bigger backlog to work off.",
      "overrides": [
        {
          "target": {
            "kind": "workload"
          },
          "path": "faults",
          "value": [
            {
              "id": "carrier-hangs",
              "kind": "latency",
              "target": "fulfilment-carrier",
              "startS": 50,
              "durationS": 40,
              "extraMs": 3000,
              "label": "carrier network path hangs"
            }
          ]
        },
        {
          "target": {
            "kind": "node",
            "id": "fulfil-q"
          },
          "path": "memoryGib",
          "value": 4
        }
      ]
    }
  ],
