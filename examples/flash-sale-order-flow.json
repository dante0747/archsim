  "workload": {
    "rps": 600,
    "durationS": 120,
    "warmupS": 10,
    "seed": 42,
    "readRatio": 0.85,
    "arrivalProcess": "poisson",
    "pattern": {
      "kind": "burst",
      "burstRps": 2400,
      "startS": 20,
      "durationS": 20
    },
    "keyCount": 5000,
    "keySkew": 0.8,
    "faults": []
