      "id": "spof:db|",
      "severity": "medium",
      "rule": "spof",
      "title": "PostgreSQL has no replica",
      "detail": "A primary failure is an outage for every read and write that reaches it.",
      "suggestion": "Add a standby or read replicas (relational), a replica set (document stores) or replication factor 3 (wide-column).",
      "nodeIds": [
        "db"
      ],
      "edgeIds": []
    },
    {
      "id": "edge-rate-limit:lb|",
      "severity": "low",
      "rule": "edge-rate-limit",
      "title": "No rate limit at the edge",
      "detail": "Nothing in front of the system caps traffic, so a spike, a retry storm or a bot flood reaches every tier at full force.",
      "suggestion": "Add a rate limit on the gateway or load balancer sized to the capacity you have measured.",
      "nodeIds": [
        "lb"
      ],
      "edgeIds": []
    },
    {
      "id": "missing-timeout:lb+api|lb-api",
      "severity": "low",
      "rule": "missing-timeout",
      "title": "Load Balancer waits indefinitely on API Servers",
      "detail": "No timeout on API Servers: a slow or hung dependency keeps Load Balancer's workers waiting until its pool fills and requests queue behind them.",
      "suggestion": "Set per-call timeouts a little above each dependency's p99 (for example 2\u00d7 p99), keeping their sum inside the caller's own budget.",
      "nodeIds": [
        "lb",
        "api"
      ],
      "edgeIds": [
        "lb-api"
      ]
    },
    {
      "id": "spof:lb|",
      "severity": "low",
      "rule": "spof",
      "title": "Load Balancer is a single instance",
      "detail": "Load Balancer is modelled as one self-hosted instance; if it stops, nothing behind it is reachable.",
      "suggestion": "Run two instances with failover (floating IP, DNS) or use a managed load balancer.",
      "nodeIds": [
