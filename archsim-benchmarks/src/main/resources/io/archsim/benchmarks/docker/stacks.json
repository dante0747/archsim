{
  "cacheStacks": ["cache", "cache-ttl"],
  "postgresEveryRequest": [
    "postgres", "java-mixed", "go-mixed", "python-mixed", "chain", "python-cores", "python-wide", "go-pool"
  ],
  "containers": {
    "postgres": ["api", "postgres"],
    "cache": ["api", "postgres", "redis"],
