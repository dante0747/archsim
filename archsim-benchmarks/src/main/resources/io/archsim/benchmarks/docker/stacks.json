    "go-mixed": ["api-go", "postgres"],
    "python-mixed": ["api-python", "postgres"],
    "chain": ["gateway", "chain-api", "postgres"],
    "cache-ttl": ["api-ttl", "postgres", "redis-ttl"],
    "python-cores": ["api-python-cores", "postgres"],
    "python-wide": ["api-python-wide", "postgres"],
    "go-pool": ["api-go-pool", "postgres"]
  },
  "behindQueue": {
    "kafka": ["consumer", "postgres"]
  },
  "k6Cpus": {
    "postgres": "0,1,6,7",
    "cache": "0,6,7",
