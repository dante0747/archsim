<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
	ArchSim's Java rules (docs/java-conventions.md). Spring Framework's own checks, then the
	clean-code rules Spring's set leaves out: sizes, complexity, naming, Javadoc on the public API,
	no JSON in strings, and how tests are named. Every finding is an error: the build has no
	warnings to ignore.
-->
<module name="com.puppycrawl.tools.checkstyle.Checker">
	<property name="severity" value="error"/>
	<property name="tabWidth" value="4"/>
	<property name="fileExtensions" value="java"/>

	<module name="SuppressionFilter">
		<property name="file" value="${config_loc}/suppressions.xml"/>
	</module>

	<!-- Spring Framework's style: tabs, `this.` for fields, import order, Javadoc form, lambdas,
	     ternaries, catch variables, test classes named *Tests. Git records authors, so the
	     `@author` tag is not required: its JavadocType check is replaced below. -->
	<module name="io.spring.javaformat.checkstyle.SpringChecks">
		<property name="headerType" value="none"/>
		<property name="projectRootPackage" value="io.archsim"/>
		<property name="excludes" value="com.puppycrawl.tools.checkstyle.checks.javadoc.JavadocTypeCheck,
				com.puppycrawl.tools.checkstyle.checks.coding.NestedIfDepthCheck,
				com.puppycrawl.tools.checkstyle.checks.coding.NestedForDepthCheck,
				com.puppycrawl.tools.checkstyle.checks.coding.NestedTryDepthCheck"/>
		<property name="avoidStaticImportExcludes" value="org.assertj.core.api.Assertions.*,
				org.assertj.core.api.Assumptions.*,
				org.mockito.BDDMockito.*,
				org.mockito.ArgumentMatchers.*,
				org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*,
				org.springframework.test.web.servlet.result.MockMvcResultMatchers.*,
				com.tngtech.archunit.lang.syntax.ArchRuleDefinition.*,
				com.tngtech.archunit.library.Architectures.*,
				com.tngtech.archunit.library.dependencies.SlicesRuleDefinition.*"/>
	</module>

	<!-- Size -->
	<module name="FileLength">
		<property name="max" value="400"/>
	</module>
	<!-- Besides imports and links, the last line of an annotated record component (it has an
	     annotation, no string longer than a short default, and ends with the component's name) may
	     run longer: the formatter keeps a component's annotations on one line and cannot wrap
	     between them. A description belongs in the package's Descriptions class. -->
	<module name="LineLength">
		<property name="max" value="120"/>
		<property name="ignorePattern" value="^(package|import) |https?://|^(?:[^&quot;]|&quot;[^&quot;]{0,24}&quot;)*@\w+(?:[^&quot;]|&quot;[^&quot;]{0,24}&quot;)*\s[a-z]\w*(,|\)( \{)?)$"/>
	</module>

	<module name="TreeWalker">
		<!-- Javadoc: the public API says what it does and why; the form is Spring's. -->
		<module name="JavadocType">
			<property name="scope" value="package"/>
		</module>
		<module name="MissingJavadocType">
			<property name="scope" value="public"/>
		</module>
		<module name="MissingJavadocMethod">
			<property name="scope" value="public"/>
			<property name="minLineCount" value="2"/>
			<property name="allowMissingPropertyJavadoc" value="true"/>
			<property name="tokens" value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF"/>
		</module>
		<module name="JavadocParagraph"/>
		<module name="JavadocBlockTagLocation"/>
		<module name="JavadocMissingWhitespaceAfterAsterisk"/>
		<module name="InvalidJavadocPosition"/>
		<module name="JavadocContentLocation"/>
		<module name="TodoComment">
			<property name="format" value="(TODO|FIXME|XXX)"/>
			<message key="todo.match" value="Finish the work or open an issue: no TODO, FIXME or XXX comments."/>
		</module>

		<!-- Small methods and classes that do one thing -->
		<module name="MethodLength">
			<property name="max" value="30"/>
			<property name="countEmpty" value="false"/>
		</module>
		<module name="LambdaBodyLength">
			<property name="max" value="10"/>
		</module>
		<module name="AnonInnerLength">
			<property name="max" value="20"/>
		</module>
		<module name="ParameterNumber">
			<property name="max" value="4"/>
			<property name="ignoreOverriddenMethods" value="true"/>
			<property name="tokens" value="METHOD_DEF, CTOR_DEF"/>
		</module>
		<module name="CyclomaticComplexity">
			<property name="max" value="10"/>
			<property name="switchBlockAsSingleDecisionPoint" value="true"/>
		</module>
		<module name="NPathComplexity">
			<property name="max" value="200"/>
		</module>
		<module name="BooleanExpressionComplexity">
			<property name="max" value="3"/>
		</module>
		<module name="NestedIfDepth">
			<property name="max" value="2"/>
		</module>
		<module name="NestedForDepth">
			<property name="max" value="1"/>
		</module>
		<module name="NestedTryDepth">
			<property name="max" value="1"/>
		</module>
		<!-- The codec's annotations (@Default, @Ge, @Ui, ...) declare a record's JSON; they don't
		     couple it to other code, so they don't count. The rest of the codec does. -->
		<module name="ClassFanOutComplexity">
			<property name="max" value="20"/>
			<property name="excludeClassesRegexps" value="^(Choice|Const|Default|DefaultFrom|Description|Ge|Gt|Le|Lt|Matches|MaxItems|MaxLength|MinItems|MinLength|OmitWhenDefault|Tag|Tagged|Ui|UniqueItems)$"/>
		</module>

		<!-- Names that say what they hold: no one-letter names outside for loops -->
		<module name="PackageName">
			<property name="format" value="^io\.archsim(\.[a-z][a-z0-9]*)*$"/>
		</module>
		<module name="TypeName"/>
		<module name="MethodName">
			<property name="id" value="methodName"/>
		</module>
		<module name="ConstantName"/>
		<module name="StaticVariableName"/>
		<module name="MemberName"/>
		<module name="RecordComponentName"/>
		<module name="ParameterName">
			<property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
		</module>
		<module name="LambdaParameterName">
			<property name="format" value="^([a-z][a-zA-Z0-9]+|_)$"/>
		</module>
		<module name="LocalVariableName">
			<property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
			<property name="allowOneCharVarInForLoop" value="true"/>
		</module>
		<module name="LocalFinalVariableName">
			<property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
		</module>
		<module name="PatternVariableName">
			<property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
		</module>
		<module name="ClassTypeParameterName"/>
		<module name="MethodTypeParameterName"/>
		<module name="InterfaceTypeParameterName"/>
		<module name="RecordTypeParameterName"/>
		<module name="AbbreviationAsWordInName">
			<property name="allowedAbbreviationLength" value="1"/>
		</module>

		<!-- Design and coding -->
		<module name="VisibilityModifier">
			<property name="protectedAllowed" value="true"/>
		</module>
		<module name="HiddenField">
			<property name="ignoreConstructorParameter" value="true"/>
			<property name="ignoreSetter" value="true"/>
			<property name="ignoreAbstractMethods" value="true"/>
			<property name="tokens" value="VARIABLE_DEF, LAMBDA, PATTERN_VARIABLE_DEF"/>
		</module>
		<module name="DeclarationOrder"/>
		<module name="OverloadMethodsDeclarationOrder"/>
		<module name="IllegalCatch"/>
		<module name="IllegalThrows"/>
		<module name="EmptyCatchBlock"/>
		<module name="MissingSwitchDefault"/>
		<module name="FallThrough"/>
		<module name="DefaultComesLast"/>
		<module name="EqualsAvoidNull"/>
		<module name="ExplicitInitialization"/>
		<module name="ModifiedControlVariable"/>
		<!-- every default token but LAMBDA: Spring's style puts a lambda's one parameter in
		     parentheses -->
		<module name="UnnecessaryParentheses">
			<property name="tokens" value="EXPR, IDENT, NUM_DOUBLE, NUM_FLOAT, NUM_INT, NUM_LONG,
					STRING_LITERAL, LITERAL_NULL, LITERAL_FALSE, LITERAL_TRUE, ASSIGN, BAND_ASSIGN,
					BOR_ASSIGN, BSR_ASSIGN, BXOR_ASSIGN, DIV_ASSIGN, MINUS_ASSIGN, MOD_ASSIGN,
					PLUS_ASSIGN, SL_ASSIGN, SR_ASSIGN, STAR_ASSIGN, TEXT_BLOCK_LITERAL_BEGIN, LAND,
					LITERAL_INSTANCEOF, GT, LT, GE, LE, EQUAL, NOT_EQUAL, UNARY_MINUS, UNARY_PLUS, INC,
					DEC, LNOT, BNOT, POST_INC, POST_DEC"/>
		</module>
		<module name="UnusedLocalVariable"/>
		<module name="MagicNumber">
			<property name="ignoreNumbers" value="-1, 0, 1, 2"/>
			<property name="ignoreHashCodeMethod" value="true"/>
			<property name="ignoreAnnotation" value="true"/>
			<property name="ignoreFieldDeclaration" value="true"/>
		</module>

		<!-- JSON is data: it belongs in a resource file or is built through the codec. -->
		<module name="IllegalTokenText">
			<property name="id" value="jsonInStrings"/>
			<property name="tokens" value="STRING_LITERAL, TEXT_BLOCK_CONTENT"/>
			<property name="format" value="^&quot;?\s*[\[{]\s*\\?&quot;"/>
			<property name="message" value="JSON belongs in a resource file or is built through the codec, not in a string."/>
		</module>
		<module name="RegexpSinglelineJava">
			<property name="id" value="oneEnumConstantPerLine"/>
			<property name="format" value="^\s*[A-Z][A-Z0-9_]*(\([^)]*\))?\s*,\s*[A-Z][A-Z0-9_]*\s*(\(|,|;|$)"/>
			<property name="ignoreComments" value="true"/>
			<property name="message" value="One enum constant per line, each with its own Javadoc."/>
		</module>
		<module name="RegexpSinglelineJava">
			<property name="format" value="System\.(out|err)\.print|\.printStackTrace\("/>
			<property name="ignoreComments" value="true"/>
			<property name="message" value="Log or throw instead of printing."/>
		</module>

		<!-- Tests are named method_state_result: what is called, in which state, what happens.
		     Other methods are camelCase. Each rule is switched off for the methods of the other. -->
		<module name="MethodName">
			<property name="id" value="testMethodName"/>
			<property name="format" value="^[a-z][a-zA-Z0-9]*_[a-z][a-zA-Z0-9]*_[a-z][a-zA-Z0-9]*$"/>
			<message key="name.invalidPattern"
					value="Name a test method_state_result, such as create_withReadOnlyToken_isForbidden (''{0}'')."/>
		</module>
		<module name="SuppressionXpathSingleFilter">
			<property name="id" value="testMethodName"/>
			<property name="query" value="//METHOD_DEF[not(./MODIFIERS/ANNOTATION/IDENT[@text='Test' or @text='ParameterizedTest' or @text='TestFactory'
					or @text='RepeatedTest' or @text='TestTemplate' or @text='Property' or @text='Example'])]/IDENT"/>
		</module>
		<module name="SuppressionXpathSingleFilter">
			<property name="id" value="methodName"/>
			<property name="query" value="//METHOD_DEF[./MODIFIERS/ANNOTATION/IDENT[@text='Test' or @text='ParameterizedTest' or @text='TestFactory'
					or @text='RepeatedTest' or @text='TestTemplate' or @text='Property' or @text='Example']]/IDENT"/>
		</module>
	</module>
</module>
