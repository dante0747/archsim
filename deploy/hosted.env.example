# The hosted stack's settings (compose.yaml, docs/deployment.md). Copy this file to hosted.env,
# next to it, and fill that in: it holds the server's secrets, so it stays on the server, readable
# by you alone, and git ignores it.
#
#   cp hosted.env.example hosted.env && chmod 600 hosted.env
#
# Compose reads it (docker compose --env-file hosted.env ...) and gives each container only the
# settings it needs. ../.env.example describes every setting the API and the web app read.

# --- Required ---------------------------------------------------------------------------------
# The way in, which Compose reads from here:
#   caddy    Caddy serves HTTPS on ports 80 and 443, with a certificate from Let's Encrypt
#   tunnel   a Cloudflare Tunnel: Cloudflare serves HTTPS, and the server publishes no port
COMPOSE_PROFILES=caddy

# With the tunnel, its token: Cloudflare Zero Trust > Networks > Tunnels > your tunnel.
# TUNNEL_TOKEN=

# The address people open, without https://. With Caddy, its DNS record must point at this server
# before the first start, when Caddy gets the certificate for it; with the tunnel, it is the
# tunnel's public hostname.
ARCHSIM_DOMAIN=app.example.com

# The database's password. Letters and digits only, since it goes into a URL:
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Signs the sign-in state and derives CSRF tokens; 32 or more characters:
#   openssl rand -base64 48
ARCHSIM_SECRET_KEY=

# A GitHub OAuth app (GitHub > Settings > Developer settings > OAuth Apps) whose homepage is
# https://<domain> and whose authorization callback URL is
# https://<domain>/api/v1/auth/github/callback.
ARCHSIM_GITHUB_CLIENT_ID=
ARCHSIM_GITHUB_CLIENT_SECRET=

# Verified emails, comma separated, whose first sign-in makes them an owner of the default
# workspace: yours.
ARCHSIM_ADMIN_EMAILS=

# --- Optional ---------------------------------------------------------------------------------
# A Google OAuth client as well, whose callback URL is https://<domain>/api/v1/auth/google/callback.
# ARCHSIM_GOOGLE_CLIENT_ID=
# ARCHSIM_GOOGLE_CLIENT_SECRET=

# The largest run, in expected requests, and its wall clock in seconds: tighter than a local
# install's 2000000 and 300 for a public demo, and still more than any template needs.
# Sandboxes keep their own 200000 and 20.
# ARCHSIM_MAX_REQUESTS=1000000
# ARCHSIM_MAX_WALL_SECONDS=120

# The JVMs' sizes. The defaults fit 2 cores and 4 GB: a worker that simulates two runs at once
# with a 1 GB heap, and an API with 512 MB. A container's memory limit is its heap and 384 MB.
# On 4 cores and 8 GB or more, give the worker three runs (a core left to the rest) and the heap
# archsim-app/README.md asks (512 MB a run and 256 MB besides), and the API 1 GB:
#   ARCHSIM_MAX_CONCURRENT_RUNS=3, ARCHSIM_WORKER_HEAP=2g, ARCHSIM_WORKER_MEMORY=2432m,
#   ARCHSIM_API_HEAP=1g, ARCHSIM_API_MEMORY=1408m
# ARCHSIM_MAX_CONCURRENT_RUNS=2
# ARCHSIM_WORKER_HEAP=1g
# ARCHSIM_WORKER_MEMORY=1408m
# ARCHSIM_API_HEAP=512m
# ARCHSIM_API_MEMORY=896m

# The nightly backup: the hour of the dump (0 to 23, UTC), and how many dumps to keep.
# ARCHSIM_BACKUP_HOUR=3
# ARCHSIM_BACKUP_KEEP=7
